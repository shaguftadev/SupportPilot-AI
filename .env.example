APP_ENV=development
DEMO_MODE=true
APP_SECRET=change-me-before-deployment
DATABASE_URL=postgresql+psycopg://supportpilot:supportpilot@db:5432/supportpilot
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=supportpilot_knowledge
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=20

# Outbound email (SMTP). Use a provider app-password/API SMTP credential, not your regular account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SupportPilot Support
SMTP_REPLY_TO=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# LangGraph durable workflow checkpointing
WORKFLOW_CHECKPOINT_ENABLED=true

# Public deployment: frontend build-time API URL (frontend/.env.production)
# VITE_API_BASE_URL=https://your-api-host/api
